# ---------- Serveur ----------
NODE_ENV=development
PORT=4000
# Origines autorisées (CORS), séparées par des virgules. La première sert aussi pour les liens des emails.
CLIENT_URL=http://localhost:5173

# ---------- Base de données (TiDB Cloud, compatible MySQL) ----------
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=mh_menu
# TiDB Cloud exige TLS. Mettre false uniquement pour un MySQL local.
DB_SSL=true

# ---------- Authentification ----------
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- Emails (Resend) ----------
RESEND_API_KEY=
# Doit appartenir à un domaine vérifié dans Resend
EMAIL_FROM=MH Menu <no-reply@mhmenu.com>

# ---------- Images (Cloudinary) - utilisé à partir de la phase 3 ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Abonnements ----------
TRIAL_DAYS=3

# ---------- Super Admin (utilisé uniquement par `npm run seed:admin`) ----------
SUPERADMIN_NAME=MH Digital Solution
SUPERADMIN_EMAIL=
# 12 caractères minimum, avec majuscule, minuscule et chiffre
SUPERADMIN_PASSWORD=
